<?xml version="1.0" encoding="utf-8"?>
<!-- The board's name, the touch pad filling the middle, the link state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent" android:layout_height="match_parent"
              android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/board"
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:gravity="center" android:textSize="20sp" android:textColor="@color/fg"
              android:paddingBottom="16dp" />
    <TextView android:id="@+id/pad"
              android:layout_width="match_parent" android:layout_height="0dp"
              android:layout_weight="1" android:gravity="center" android:background="@drawable/pad"
              android:textSize="44sp" android:textStyle="bold" android:textColor="@color/faint" />
    <TextView android:id="@+id/detail"
              android:layout_width="match_parent" android:layout_height="wrap_content"
              android:gravity="center" android:textSize="18sp" android:textColor="@color/faint"
              android:paddingTop="16dp" />
</LinearLayout>
